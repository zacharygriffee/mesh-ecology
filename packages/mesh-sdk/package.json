{
  "name": "@mesh/mesh-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "guard:bare-import-graph": "node ./scripts/check-bare-import-graph.js",
    "smoke:node-exports": "node ./scripts/smoke-node-exports.js",
    "test:conformance": "node ./test/conformance.test.js",
    "test:hashport": "node ./test/hashport.contract.test.js",
    "test:hashport-conformance": "node ./test/hashport.conformance.test.js",
    "test:hashport-parity": "node ./test/hashport.parity.test.js",
    "test:bare-runtime": "bare ./test/bare-runtime.smoke.js",
    "test:bare-e2e": "bare ./test/bare-e2e.materialization.test.js",
    "test:bare-labs": "bare ../../test/bare-labs/run.js",
    "guard:bare-e2e-import-graph": "node ./scripts/check-bare-e2e-import-graph.js"
  },
  "imports": {
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "node:path": {
      "bare": "bare-path",
      "default": "node:path"
    }
  },
  "exports": {
    ".": {
      "node": "./src/entry/node.js",
      "default": "./src/entry/bare.js"
    },
    "./node": "./src/entry/node.js",
    "./bare": "./src/entry/bare.js"
  },
  "dependencies": {
    "bare-path": "^3.0.0",
    "hypercore-crypto": "^3.6.1"
  }
}
